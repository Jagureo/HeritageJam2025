theme_override_fonts/normal_font = ExtResource("4_wfx2n")
theme_override_font_sizes/normal_font_size = 35
bbcode_enabled = true
text = "[color=yellow]> GAMEPLAY <[/color]
Travel back to the 90's and promote some gracious travelling in Singapore's MRT.

Every traveler has their own preferences, can you ensure has the most pleasant ride, but also extend that courtesy to other travelers.

Hover over the passengers to uncover their traits and preferences and help them find their optimal seating.

Simply hold [color=orange][Left click][/color] to drag the passengers and make sure you seat everyone before the doors close!

After the doors close your happiness score will be calculated for the round based on how well you were able to seat everyone, but beware, if your happiness drops below (-25) the train will ignite and derail spontaneously simultaneously."
autowrap_mode = 2
vertical_alignment = 1
justification_flags = 160

